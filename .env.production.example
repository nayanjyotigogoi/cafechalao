# CafeChalao website, production build for https://tohfaah.com (one café per site).
# These are read when the image is BUILT (docker-compose.prod.yml passes them as build args).
NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_URL=https://tohfaah.online
# The café this site serves, and lock it so ?outlet= in a link can't switch to another café.
NEXT_PUBLIC_DEFAULT_TENANT=cafe-1bhk
NEXT_PUBLIC_TENANT_LOCKED=true
