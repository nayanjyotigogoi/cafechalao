# Used automatically by `npm run build` (and on Vercel/any host) for the live site. No secrets here.
# A .env.local file overrides these, so don't upload .env.local to the server.
NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_URL=https://tohfaah.online
NEXT_PUBLIC_DEFAULT_TENANT=cafe-1bhk
NEXT_PUBLIC_TENANT_LOCKED=true
