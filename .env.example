# http = the Laravel API (backend repo CC-BEND; run: php artisan serve --port=8000); mock = dummy data inside the browser
NEXT_PUBLIC_API_MODE=http
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_TENANT=cafe-1bhk
# Local: ?outlet=<slug> in the address can switch café. Production sets this to true.
NEXT_PUBLIC_TENANT_LOCKED=false
